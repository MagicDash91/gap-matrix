# Generator: groq (default, sesuai infrastruktur mata kuliah) atau gemini (Gemma 4)
LLM_PROVIDER=groq
GROQ_API_KEY=isi-api-key-groq
GROQ_MODEL=llama-3.3-70b-versatile
# GOOGLE_API_KEY=isi-jika-LLM_PROVIDER=gemini
# GEMMA_MODEL=gemma-4-31b-it
# Embedding lokal (sentence-transformers), tanpa API
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
TOP_K=6
RPM_SLEEP=2.0
